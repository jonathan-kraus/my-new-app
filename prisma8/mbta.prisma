// use prisma-8
model MbtaStop {
  id              String @id
  name            String
  latitude        Float?
  longitude       Float?
  parentStationId String?
  locationType    Int
  attributes      Jsonb
  patternStops    MbtaPatternStop[]

  @@index([parentStationId])
}

model MbtaRoute {
  id         String @id
  name       String
  color      String
  textColor  String
  routeType  Int
  sortOrder  Int
  attributes Jsonb
  patterns   MbtaPattern[]
}

model MbtaPattern {
  id          String @id
  routeId     String
  name        String
  directionId Int
  typicality  Int
  sortOrder   Int
  route       MbtaRoute @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stops       MbtaPatternStop[]
}

model MbtaPatternStop {
  id        String @id
  patternId String
  stopId    String
  position  Int
  pattern   MbtaPattern @relation(fields: [patternId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stop      MbtaStop @relation(fields: [stopId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([patternId, position], unique: true)
  @@index([stopId])
}

model MbtaSyncState {
  id            String @id
  lastAttemptAt String
  lastSuccessAt String?
  lastError     String?
  routeCount    Int
  stopCount     Int
  patternCount  Int
}

