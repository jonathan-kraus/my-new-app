{
  "compilerOptions": {
    /* Core strictness */
    "strict": true,
    "strictNullChecks": true, 
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    /* Module + resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals"],
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    /* JSX */
    "jsx": "react-jsx",
    /* Paths (TS6‑clean + deterministic) */

    "paths": {
      "@/app/*": ["./app/*"],
      "@/auth": ["./auth"],
      "@/components/*": ["./app/components/*"],
      "@/db/*": ["./src/db/*"],
      "@/generated/*": ["./src/lib/generated/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/lib/*": ["./lib/*"],
      "@/tests/*": ["./tests/*"],
      "@/types/*": ["./types/*"],
      "@/version.json": ["./version.json"]
    },
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  /* Next.js required include */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  /* Exclude build artifacts + generated code */
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "src/lib/generated/prisma"
  ]
}
