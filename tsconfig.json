{
  "compilerOptions": {
    /* Core strictness */
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    /* Module + resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "next", "next/types", "vitest/globals"],
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    /* JSX */
    "jsx": "react-jsx",

    /* ⭐ Critical: allow root-level aliasing */
    "baseUrl": ".",

    /* ⭐ Clean, deterministic alias map */
    "paths": {
      "@/app/*": ["./app/*"],
      "@/auth": ["./auth.ts"],
      "@/components/*": ["./app/components/*"],
      "@/db/*": ["./src/db/*"],
      "@/emails/*": ["./emails/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/tests/*": ["./tests/*"],
      "@/types/*": ["./types/*"],
      "@/version.json": ["./version.json"]
    },

    "noEmit": true,
    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  /* Next.js required include */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  /* Exclude build artifacts + generated code */
  "exclude": ["node_modules", ".next", "dist", "coverage"]
}
