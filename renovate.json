{
  "extends": ["config:recommended"],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,

  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "automerge": true,
      "automergeType": "branch"
    },

    {
      "groupName": "Next.js ecosystem",
      "matchPackagePatterns": [
        "^next$",
        "^eslint-config-next$",
        "^@next/",
        "^@vercel/"
      ]
    },

    {
      "groupName": "Prisma",
      "matchPackagePatterns": [
        "^prisma$",
        "^@prisma/"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },

    {
      "groupName": "Vitest",
      "matchPackagePatterns": [
        "^vitest$",
        "^@vitest/"
      ]
    },

    {
      "groupName": "Tailwind",
      "matchPackagePatterns": [
        "^tailwindcss$",
        "^@tailwindcss/"
      ]
    },

    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
