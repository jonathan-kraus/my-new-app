{
  "extends": [":dependencyDashboard"],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "groupName": "Next.js ecosystem",
      "matchPackageNames": [
        "/^next$/",
        "/^eslint-config-next$/",
        "/^@next\\//",
        "/^@vercel\\//"
      ]
    },
    {
      "description": "Manage Prisma 7 development package manually",
      "matchPackageNames": ["@prisma/prisma7"],
      "enabled": false
    },
    {
      "groupName": "Vitest",
      "matchPackageNames": ["/^vitest$/", "/^@vitest\\//"]
    },
    {
      "groupName": "Tailwind",
      "matchPackageNames": ["/^tailwindcss$/", "/^@tailwindcss\\//"]
    },
    {
      "description": "Manage TypeScript updates manually",
      "matchPackageNames": ["typescript"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "safe-minor-patch-updates",
      "automerge": true
    }
  ]
}
