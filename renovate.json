{
  "extends": [":dependencyDashboard"],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "groupName": "Next.js ecosystem",
      "matchPackageNames": [
        "/^next$/",
        "/^eslint-config-next$/",
        "/^@next\\//",
        "/^@vercel\\//"
      ]
    },
    {
      "groupName": "Prisma",
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "matchPackageNames": ["/^prisma$/", "/^@prisma\\//"]
    },
    {
      "groupName": "Vitest",
      "matchPackageNames": ["/^vitest$/", "/^@vitest\\//"]
    },
    {
      "groupName": "Tailwind",
      "matchPackageNames": ["/^tailwindcss$/", "/^@tailwindcss\\//"]
    },
    {
      "description": "Pin TypeScript to v5.x (TS 7 breaks ESLint + Next.js tooling)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "safe-minor-patch-updates",
      "automerge": true
    }
  ]
}
