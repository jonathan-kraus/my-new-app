{
  "extends": [":dependencyDashboard"],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,

  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },

    {
      "groupName": "Next.js ecosystem",
      "matchPackagePatterns": ["^next$", "^eslint-config-next$", "^@next/", "^@vercel/"]
    },

    {
      "groupName": "Prisma",
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "matchPackagePatterns": ["^prisma$", "^@prisma/"]
    },

    {
      "groupName": "Vitest",
      "matchPackagePatterns": ["^vitest$", "^@vitest/"]
    },

    {
      "groupName": "Tailwind",
      "matchPackagePatterns": ["^tailwindcss$", "^@tailwindcss/"]
    },

    {
      "description": "Pin TypeScript to v5.x (TS 7 breaks ESLint + Next.js tooling)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0"
    },
    {
      "description": "Pin ESLint to v9.x (ESLint 10 breaks plugins)",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "Pin @typescript-eslint packages to versions compatible with TS 5.x",
      "matchPackagePatterns": ["^@typescript-eslint/"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Prevent upgrades of eslint-plugin-* packages beyond ESLint 9 compatibility",
      "matchPackagePatterns": [
        "^eslint-plugin-import$",
        "^eslint-plugin-react$",
        "^eslint-plugin-jsx-a11y$"
      ],
      "allowedVersions": "<8.0.0"
    },

    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "safe-minor-patch-updates",
      "automerge": true
    }
  ]
}