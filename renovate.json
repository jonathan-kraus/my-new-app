{
  "extends": [":dependencyDashboard"],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,

  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },

    {
      "groupName": "Next.js ecosystem",
      "matchPackageNames": [
        "/^next$/",
        "/^eslint-config-next$/",
        "/^@next//",
        "/^@vercel//"
      ]
    },

    {
      "groupName": "Prisma",
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "matchPackageNames": [
        "/^prisma$/",
        "/^@prisma//"
      ]
    },

    {
      "groupName": "Vitest",
      "matchPackageNames": [
        "/^vitest$/",
        "/^@vitest//"
      ]
    },

    {
      "groupName": "Tailwind",
      "matchPackageNames": [
        "/^tailwindcss$/",
        "/^@tailwindcss//"
      ]
    },

    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
