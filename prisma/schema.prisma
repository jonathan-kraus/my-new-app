generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model AstronomySnapshot {
  id                 String   @id @default(cuid())
  locationId         String
  fetchedAt          DateTime
  sunrise            String
  sunset             String
  moonrise           String?
  moonset            String?
  moonPhase          Float?
  sunriseBlueStart   String?
  sunriseBlueEnd     String?
  sunriseGoldenStart String?
  sunriseGoldenEnd   String?
  sunsetGoldenStart  String?
  sunsetGoldenEnd    String?
  sunsetBlueStart    String?
  sunsetBlueEnd      String?
  solarNoon          String?
  illumination       Float?
  phaseName          String?
  dateString         String   @db.VarChar(10)
  Location           Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, dateString])
}

model DbTableStats {
  id           String   @id @default(cuid())
  tableName    String
  rowEstimate  Int
  totalBytes   BigInt
  indexBytes   BigInt
  tableBytes   BigInt
  toastBytes   BigInt
  snapshotDate DateTime
  createdAt    DateTime @default(now())

  @@unique([tableName, snapshotDate])
  @@index([tableName, snapshotDate])
}

model EphemerisDebug {
  id                 String   @id @default(cuid())
  locationId         String?
  fetchedAt          String?
  createdAt          String?
  date               String?
  sunrise            String?
  sunset             String?
  moonrise           String?
  moonset            String?
  moonPhase          Float?
  sunriseBlueStart   String?
  sunriseBlueEnd     String?
  sunriseGoldenStart String?
  sunriseGoldenEnd   String?
  sunsetGoldenStart  String?
  sunsetGoldenEnd    String?
  sunsetBlueStart    String?
  sunsetBlueEnd      String?
  raw                Json
  receivedAt         DateTime @default(now())
}

model ForecastSnapshot {
  id         String   @id @default(cuid())
  locationId String
  fetchedAt  DateTime @default(now())
  payload    Json
  Location   Location @relation(fields: [locationId], references: [id])
}

model GithubEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  type          String
  repo          String
  actor         String?
  status        String?
  conclusion    String?
  commitSha     String?
  commitMessage String?
  url           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  raw           Json?
}

model Location {
  id                String              @id @default(cuid())
  key               String              @unique
  name              String
  latitude          Float
  longitude         Float
  timezone          String
  isDefault         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  AstronomySnapshot AstronomySnapshot[]
  ForecastSnapshot  ForecastSnapshot[]
  WeatherSnapshot   WeatherSnapshot[]
}

model Log {
  id           Int      @id @default(autoincrement())
  level        String
  message      String
  requestId    String?
  domain       String
  payload      Json
  meta         Json?
  userId       String?
  sessionEmail String?
  sessionUser  String?
  file         String?
  line         Int?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([domain])
  @@index([file])
  @@index([level])
  @@index([meta], type: Gin)
  @@index([payload], type: Gin)
  @@index([requestId])
  @@index([sessionEmail])
  @@index([sessionUser])
  @@index([userId])
}

model Note {
  id          String    @id @default(nanoid(12))
  userId      String
  userEmail   String
  title       String?
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  followUpAt  DateTime?
  isCompleted Boolean   @default(false)
  isArchived  Boolean   @default(false)
  pinned      Boolean   @default(false)
  tags        String[]  @default([])
  color       String?

  @@index([followUpAt])
  @@index([isArchived])
  @@index([isCompleted])
  @@index([userEmail])
  @@index([userId])
}

model RuntimeConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model TravelSnapshot {
  id               String          @id @default(cuid())
  source           String
  receivedAt       DateTime
  confirmationCode String
  issuedDate       String
  passengers       Json
  payment          Json
  bags             Json
  rawHtml          String
  segments         TravelSegment[]

  @@index([receivedAt])
}

model TravelSegment {
  id               String         @id @default(cuid())
  snapshotId       String
  date             String
  departureAirport String
  departureCity    String
  departureTime    String
  arrivalAirport   String
  arrivalCity      String
  arrivalTime      String
  flightNumber     String
  operatedBy       String?
  marketedAs       String?
  cabin            String?
  fareClass        String?
  seats            String[]
  snapshot         TravelSnapshot @relation(fields: [snapshotId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model UserRole {
  email String @id
  role  String
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WeatherSnapshot {
  id            String   @id @default(cuid())
  locationId    String
  temperature   Float
  feelsLike     Float?
  humidity      Float?
  windSpeed     Float?
  windDirection Float?
  pressure      Float?
  visibility    Float?
  weatherCode   Int?
  fetchedAt     DateTime @default(now())
  Location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, fetchedAt])
}
